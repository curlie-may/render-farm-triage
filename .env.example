# ClickHouse Cloud credentials, shared by the Next.js tool routes (lib/clickhouse.ts)
# and by the ADK agent's mcp-clickhouse toolset (agent/agent.py).
CLICKHOUSE_HOST=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=

# Optional; mcp-clickhouse defaults to port 8443 with TLS when unset.
CLICKHOUSE_PORT=
CLICKHOUSE_SECURE=

# Gemini API key for the ADK agent (agent/agent.py). Get one at
# https://aistudio.google.com/apikey.
GOOGLE_API_KEY=
